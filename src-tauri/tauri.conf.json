{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "supabase-auth-app",
  "version": "0.1.0",
  "identifier": "com.genxai.supabaseauthapp",
  "build": {
    "frontendDist": "https://dev.advico.ai",
    "devUrl": "https://dev.advico.ai",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Advico Dev",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "dangerousRemoteDomainIpcAccess": [
        {
          "domain": "dev.advico.ai",
          "https": true,
          "enableTauriAPI": true
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}